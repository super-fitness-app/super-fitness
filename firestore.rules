rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Athlete user profiles & private subcollections
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // Smart Coach AI conversation messages
      match /smart_coach_chats/{sessionId}/messages/{messageId} {
        allow read, write: if request.auth != null && (request.auth.uid == userId || userId == 'default_user');
      }
    }
  }
}
